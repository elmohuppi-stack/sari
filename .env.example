# === Deployment (Pflicht) ===
APP_SLUG=sari
WEB_PORT=3061

# === Automatischer Deploy nach dem Datenlauf (optional) ===
# Die GitHub Action .github/workflows/update-data.yml committet neue RKI-Daten
# wöchentlich und deployt danach per SSH nach /var/www/sari
# (git pull --ff-only && docker compose up -d --build). Dafür sind im
# Repository unter Settings → Secrets and variables → Actions drei Secrets
# nötig. Fehlen sie, wird nur committet und der Deploy bleibt Handarbeit.
#
#   SSH_HOST  Server-IP oder Hostname
#   SSH_USER  Benutzer mit Zugriff auf /var/www/sari und docker compose
#   SSH_KEY   privater ed25519-Schlüssel (passwortlos), public Key in
#             ~/.ssh/authorized_keys des Benutzers auf dem Server
#
# Bewusst NICHT in dieser Datei: die Secret-Werte selbst. Sie gehören nur in
# die GitHub-Repo-Settings, nicht ins Repository.

# === Rechtliches ===
# Nur Platzhalter. Die echten Betreiberangaben stehen in der nicht
# versionierten .env auf dem Server — eine ladungsfähige Anschrift gehört
# nicht in ein öffentliches Repository.
VITE_LEGAL_NAME="Max Mustermann"
VITE_LEGAL_EMAIL="kontakt@example.com"
VITE_LEGAL_ADDRESS_LINE_1="Musterstraße 1"
VITE_LEGAL_ADDRESS_LINE_2="12345 Musterstadt"
VITE_LEGAL_COUNTRY="Deutschland"
VITE_LEGAL_CONTENT_RESPONSIBLE="Max Mustermann"
